on init
    # TODO(verify): USB configfs setup unconfirmed — FIRMWARE_DIR not set,
    # stock *usb*.rc audit skipped. UDC name, sys.usb.controller, and
    # configfs gadget setup need verification against stock firmware.
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs && property:ro.debuggable=0
    # TODO(verify): UDC name 'musb-hdrc' is a guess for MT6765 — needs
    # confirmation from stock vendor/etc/init/*usb*.rc
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

service touch-diag /system/bin/sh -c "dmesg | grep -E 'CTS-|ILITEK|ilitek|icnl9916|ili9882|chipone|active panel|not found|Unknown symbol|version magic|disagrees about version|Exec format|insmod' > /tmp/touch_dbg.log; echo CMDLINE: >> /tmp/touch_dbg.log; cat /proc/cmdline >> /tmp/touch_dbg.log"
    class late_start
    user root
    group root
    oneshot
    disabled

on boot
    start boot-hal-1-2
    start health-hal-2-1

    # Touch panel drivers: the stock tonga drivers, relinked for the recovery
    # kernel (their vermagic is ...-g2991a7c6cb9d, the vendor partition copies
    # are ...-gbaa59638869e and cannot be loaded by this kernel), so insmod
    # these ramdisk copies rather than modprobe from /vendor/lib/modules.
    # Load order does not matter: each driver self-selects the panel from the
    # "mipi_mot_vid_*" token in /proc/cmdline and returns -1 before binding if
    # the panel is not its own (stock loads both the same way, in
    # init.mmi.overlay.rc).
    insmod /vendor/lib/modules/ili9882_mmi.ko
    insmod /vendor/lib/modules/icnl9916_tddi_mmi.ko

    # Start touch diagnostic logger
    start touch-diag
